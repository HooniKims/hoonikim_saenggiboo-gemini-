# 로컬에서는 이 파일을 .env.local로 복사한 뒤 실제 키를 입력하세요.
# 실제 API 키가 들어 있는 .env 또는 .env.local은 커밋하지 않습니다.

# Upstage Solar Pro 4
UPSTAGE_API_KEY=
UPSTAGE_API_URL=https://api.upstage.ai/v1/chat/completions
UPSTAGE_MODEL=solar-pro4

# 브라우저에서 직접 호출하는 원격 LM Studio
# NEXT_PUBLIC_ 변수는 빌드된 JavaScript에 포함되므로 비밀값으로 간주하지 않습니다.
NEXT_PUBLIC_LMSTUDIO_API_URL=https://lm.alluser.kr
NEXT_PUBLIC_LMSTUDIO_API_KEY=

# Tavily 웹 검색 보강
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
